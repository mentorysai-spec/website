{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 /root/.claude/hooks/package-age-check.py",
                        "timeout": 15,
                        "statusMessage": "Checking package release age..."
                    }
                ]
            }
        ]
    }
}
